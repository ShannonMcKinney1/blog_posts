---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../../components/BlogPost.astro";
import { pb } from "../../lib/pocketbase";

const pageTitle = "Latest Posts | Shannon's Journal Blog";

const posts = await pb.collection("posts").getFullList({
  filter: "published = true",
  sort: "-publishedAt",
  fields: "id,slug,title,description,publishedAt,coverImage",
});
---

<BaseLayout
  pageTitle={pageTitle}
  description="Browse all posts on Shannon's Journal Blog: covering bullet journal layouts, page ideas, goal setting, and career tips."
>
  <ul>
    {(posts ?? []).map((post) => (
      <BlogPost
        url={`/blog/${post.slug}`}
        title={post.title}
        description={post.description}
      />
    ))}
  </ul>
</BaseLayout>
