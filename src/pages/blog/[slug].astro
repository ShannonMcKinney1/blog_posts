---
import { marked } from "marked";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CommentSection from "../../components/CommentSection.tsx";
import TableOfContents from "../../components/TableOfContents.astro";
import { pb } from "../../lib/pocketbase";

export async function getStaticPaths() {
  const [posts, links] = await Promise.all([
    pb.collection("posts").getFullList({ filter: "published = true" }),
    pb.collection("post_tags").getFullList({
      filter: "postId.published = true",
      expand: "tagId",
    }),
  ]);

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      tags: links
        .filter((link) => link.postId === post.id)
        .map((link) => link.expand?.tagId)
        .filter(Boolean),
    },
  }));
}

const { post, tags } = Astro.props;

// Extract headers from markdown
const headerRegex = /^(#{1,6})\s+(.+)$/gm;
const headers: Array<{ level: number; text: string; id: string }> = [];
let match;
const headerMap = new Map<string, string>();

while ((match = headerRegex.exec(post.content ?? "")) !== null) {
  const level = match[1].length;
  const text = match[2].trim();
  const id = text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
  
  if (level >= 2 && level <= 3) {
    headers.push({ level, text, id });
    headerMap.set(text, id);
  }
}

// Use marked hook to add IDs to headers during rendering
marked.use({
  renderer: {
    heading({ text, depth }) {
      if (depth >= 2 && depth <= 3) {
        const id = headerMap.get(text) || text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
        return `<h${depth} id="${id}">${text}</h${depth}>\n`;
      }
      return `<h${depth}>${text}</h${depth}>\n`;
    }
  }
});

let htmlContent = marked.parse(post.content ?? "") as string;
---

<BaseLayout pageTitle={post.title} description={post.description} hideTitle>
  {headers.length > 0 && <TableOfContents content={post.content ?? ""} />}
  <article>
    <div class="bg-background-secondary-300">
      <!-- {post.coverImage && (
        <img
          src={post.coverImage}
          alt={post.title}
          class="rounded-lg mb-4"
        />
      )} -->
      <h1>{post.title}</h1>
      <p><em>{post.description}</em></p>
      <p>Published on {new Date(post.publishedAt).toLocaleDateString()}</p>
    </div>

    <div set:html={htmlContent} />

    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag: any) => (
          <p class="tag">
            <a href={`/tags/${tag.slug}`}>{tag.name}</a>
          </p>
        ))}
      </div>
    )}

    <CommentSection client:load slug={`blog/${post.slug}`} />
  </article>
</BaseLayout>
