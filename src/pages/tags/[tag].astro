---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';
import { pb } from '../../lib/pocketbase';

export async function getStaticPaths() {
  const tags = await pb.collection('tags').getFullList({ fields: 'id,name,slug' });

  const paths = await Promise.all(
    tags.map(async (tag) => {
      const links = await pb.collection('post_tags').getFullList({
        filter: pb.filter('tagId = {:id} && postId.published = true', { id: tag.id }),
        expand: 'postId',
      });
      const posts = links
        .map((link) => link.expand?.postId)
        .filter(Boolean)
        .sort((a: any, b: any) => (b.publishedAt ?? '').localeCompare(a.publishedAt ?? ''));

      return {
        params: { tag: tag.slug },
        props: { tagName: tag.name, posts },
      };
    })
  );

  return paths;
}

const { tag } = Astro.params;
const { tagName, posts } = Astro.props;
---
<BaseLayout
  pageTitle={`${tagName} Posts | Shannon's Journal Blog`}
  description={`Browse all posts tagged with ${tagName} on Shannon's Journal Blog.`}
>
  <p>Posts tagged with <strong>{tagName}</strong></p>
  <ul>
    {posts.map((post: any) => (
      <BlogPost
        url={`/blog/${post.slug}`}
        title={post.title}
        description={post.description}
      />
    ))}
  </ul>
</BaseLayout>
